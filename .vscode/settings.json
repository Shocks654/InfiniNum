{
    // --- 1. CORE PYTHON RUNTIME INTERFACE ---
    // Forces the integrated environment to natively ingest local environment variables upon terminal launch
    "python.terminal.useEnvFile": true,
    // --- 2. FILE EXCLUSION AND VISIBILITY MATRIX ---
    // Hides machine-generated compilation directories from the active VS Code explorer view
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/*.pyc": true
    },
    // --- 3. CODE QUALITY AND FORMATTING CORES ---
    // Enforces the editor layout engine to automatically format and organize imports on file save actions
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    // --- 4. SPELL CHECK AND TEXT ISOLATION ---
    // Configures spelling dictionaries to strictly align with global international layouts
    "cSpell.language": "en",
